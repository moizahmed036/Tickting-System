# =============================================================================
# NexusFlow Enterprise Workflow & Ticketing Automation System - Environment Config
# =============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="Enterprise Workflow & Ticketing Automation System"

# Database Connection
# For Local Dev (SQLite): sqlite+aiosqlite:///./ticketing.db
# For Docker / Production (PostgreSQL):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_enterprise_secret
POSTGRES_DB=ticketing_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_enterprise_secret@db:5432/ticketing_db

# Security & JWT Tokens
SECRET_KEY=enterprise-super-secret-key-change-in-production-workflow-fsm-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hosts & Public URLs
SERVER_HOST=http://localhost:8000
FRONTEND_HOST=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Default Enterprise Superuser Credentials
FIRST_SUPERUSER_EMAIL=admin@enterprise.local
FIRST_SUPERUSER_PASSWORD=AdminPassword123!
